<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GolfSimVision</RootNamespace>
    <AssemblyName>GolfSimVision</AssemblyName>
    <!-- OpenCvSharp4's analyzer assembly targets a newer Roslyn than the installed SDK
         ships (a packaging mismatch, not a real code issue). -->
    <NoWarn>CS9057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="OpenCvSharp4" Version="4.*" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.*" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Not committed to git (*.onnx, see .gitignore): export it yourself from
         prototypes/webcam-putting/detection/models/golf_ball_v1.pt (see
         Detection/BallDetector.cs's doc comment for the exact export command) and place
         it here. The app runs without it, with detection reporting "model not found"
         rather than crashing (same graceful-degradation pattern as a missing camera). -->
    <Content Include="Models\**\*" Condition="Exists('Models')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
